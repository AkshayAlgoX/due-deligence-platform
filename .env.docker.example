# ───────────────────────────────────────────────────────────────────
# Docker environment template — copy to .env and fill in real values:
#   copy .env.docker.example .env        (Windows CMD)
# Never commit the real .env file.
# ───────────────────────────────────────────────────────────────────

# ─── Database ───
POSTGRES_DB=duediligence
POSTGRES_USER=dduser
POSTGRES_PASSWORD=changeme-strong-password

# ─── JWT (>= 32 bytes / 64 chars recommended) ───
JWT_SECRET=change-me-to-random-64-byte-string-in-production

# ─── External APIs ───
GROQ_API_KEY=gsk_xxx
CASHFREE_APP_ID=xxx
CASHFREE_SECRET_KEY=xxx
GOOGLE_OAUTH_CLIENT_SECRET=xxx

# ─── Mail (SMTP) ───
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=xxx-app-password

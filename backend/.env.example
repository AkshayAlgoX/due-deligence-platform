# ─────────────────────────────────────────────────────────────
# Real Estate Due Diligence — backend environment template
#
# HOW TO USE:
#   1. Copy this file to backend/.env
#   2. Fill in your real values
#   3. NEVER commit backend/.env — it is gitignored
#   4. If a key is committed by accident, rotate it immediately:
#      Cashfree: https://merchant.cashfree.com → API Keys → Regenerate
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────
DB_PASSWORD=your_db_password_here

# ── Gmail SMTP (transactional email) ──────────────────────
# For Gmail: create an App Password at myaccount.google.com → Security
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# ── Google OAuth (Sign in with Google) ────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Cashfree Payment Gateway (sandbox) ────────────────────
# Get test keys at https://sandbox.cashfree.com/devstudio → API Keys
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret_here

# ── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=generate_a_random_256_bit_secret

# ── WAQI air-quality API ──────────────────────────────────
# Free token from https://aqicn.org/api/
WAQI_TOKEN=your_waqi_api_token_here

# ── Google Analytics 4 ────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

GROQ_API_KEY=your_groq_api_key_here

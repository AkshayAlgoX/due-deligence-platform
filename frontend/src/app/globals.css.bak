@import "tailwindcss";

/* ── Tailwind v4: enable class-based dark mode ──────────────────────────────
   This single line makes every dark:* utility class work.
   Without it, dark:bg-* dark:text-* etc. are silently ignored in v4.
   Must come BEFORE @theme inline block.                                     */
@custom-variant dark (&:where(.dark, .dark *));

:root {
  /* ── Light mode (unchanged) ──────────────────────────────────────────── */
  --background: #F6F8FB;
  --foreground: #171717;

  /* shadcn/ui CSS variables */
  --card: #ffffff;
  --card-foreground: #171717;
  --popover: #ffffff;
  --popover-foreground: #171717;
  --primary: #16a34a;
  --primary-foreground: #ffffff;
  --secondary: #f1f5f9;
  --secondary-foreground: #0f172a;
  --muted: #f1f5f9;
  --muted-foreground: #64748b;
  --accent: #f1f5f9;
  --accent-foreground: #0f172a;
  --destructive: #ef4444;
  --destructive-foreground: #ffffff;
  --border: #e2e8f0;
  --input: #e2e8f0;
  --ring: #16a34a;
  --radius: 0.5rem;

  /* ── GitHub Dark palette as CSS vars (used in Chunks B-J) ───────────── */
  --gh-bg: #0d1117;
  --gh-card: #161b22;
  --gh-card-elevated: #1c2128;
  --gh-border: #30363d;
  --gh-text-primary: #e6edf3;
  --gh-text-secondary: #7d8590;
  --gh-text-tertiary: #6e7681;
  --gh-success-bg: #0d2818;
  --gh-error-bg: #2d1214;
  --gh-warning-bg: #282a10;
}

/* ── Dark mode overrides (GitHub Dark exact hex values) ─────────────────────
   Applied when <html class="dark"> is present.
   Only overrides CSS vars — light mode values are preserved above.          */
.dark {
  --background: #0d1117;
  --foreground: #e6edf3;

  --card: #161b22;
  --card-foreground: #e6edf3;
  --popover: #1c2128;
  --popover-foreground: #e6edf3;
  --primary: #22C55E;
  --primary-foreground: #0d1117;
  --secondary: #1c2128;
  --secondary-foreground: #e6edf3;
  --muted: #161b22;
  --muted-foreground: #7d8590;
  --accent: #1c2128;
  --accent-foreground: #e6edf3;
  --destructive: #f85149;
  --destructive-foreground: #e6edf3;
  --border: #30363d;
  --input: #1c2128;
  --ring: #22C55E;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

/* ── Global interactive cursor styles ─────────────────────────────────────── */
@layer base {

  button:not(:disabled),
  a,
  [role="button"]:not([aria-disabled="true"]),
  input[type="submit"],
  input[type="button"],
  input[type="checkbox"],
  input[type="radio"],
  label[for],
  select {
    cursor: pointer;
  }

  button:disabled,
  [aria-disabled="true"] {
    cursor: not-allowed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}

/* ── Smooth theme transition ─────────────────────────────────────────────────
   200ms ease on bg/border/color so the dark↔light flip feels premium.
   Scoped to these 3 properties only — does NOT interfere with framer-motion
   (which uses transform/opacity, not listed here).
   The .no-transition class is applied briefly during page load to prevent
   the "fade from white" flash on dark-mode users' first paint.              */
/* Theme transition — only body-level color shifts smoothly when toggling dark mode.
   Individual elements handle their own transitions via Tailwind utility classes,
   which preserves the sidebar's transition-transform duration-300 animation. */
body {
  transition: background-color 200ms ease, color 200ms ease;
}

.no-transition,
.no-transition *,
.no-transition *::before,
.no-transition *::after {
  transition: none !important;
}

/* ── Custom animations ─────────────────────────────────────────────────────── */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeIn {
  animation: fadeIn 0.4s ease-out both;
}

/* Tailwind v4 animate-in helper (used by Alert) */
@keyframes slideInFromTop {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-in {
  animation-fill-mode: both;
}

.fade-in {
  animation-name: fadeIn;
}

.slide-in-from-top-2 {
  animation-name: slideInFromTop;
}

.duration-300 {
  animation-duration: 300ms;
}

/* ── Accessibility: visible focus ring on keyboard nav ───────────────────── */
*:focus-visible {
  outline: 2px solid #22C55E;
  outline-offset: 2px;
  border-radius: 6px;
}

*:focus:not(:focus-visible) {
  outline: none;
}
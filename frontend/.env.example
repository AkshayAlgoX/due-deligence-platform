# ───────────────────────────────────────────────────────────────────
# Frontend environment template — copy to frontend/.env.local:
#   copy .env.example .env.local        (Windows CMD, run inside frontend/)
# Never commit .env.local — it is gitignored.
# All NEXT_PUBLIC_* vars are inlined into the client bundle at build
# time, so set them BEFORE running `npm run build` / deploying.
# ───────────────────────────────────────────────────────────────────

# Base URL of the backend API (no trailing slash).
# Local dev: http://localhost:8080
# Production (Vercel): https://dd-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client ID (Sign in with Google button).
# Create one at https://console.cloud.google.com → APIs & Services → Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudinary (document uploads) — free tier at https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# Google Analytics 4 measurement ID (optional analytics)
NEXT_PUBLIC_GA=G-XXXXXXXXXX
